[Unit]
Description=本地项目文件 MCP 与 OAuth 服务
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=local-files-mcp
Group=local-files-mcp
WorkingDirectory=/opt/local-files-mcp
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
Environment=LOCAL_FILES_MCP_TOKEN=
EnvironmentFile=/var/lib/local-files-mcp/oauth.env
ExecStart=/opt/local-files-mcp/bin/local-files-mcp -listen 127.0.0.1:8765 -root /srv/my-project -oauth-issuer https://mcp.example.com -oauth-state /var/lib/local-files-mcp/oauth.json
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
